subscription_key.txt
.DS_Store

# Seeder binary, dropped here by a local `go build` in scripts/seed
scripts/seed/seed
plans/
data
gpg_volume
jwt_volume
error_logs
logs/

# Generated realm files
*.realm.json
master-realm.json
passbolt-realm.json

# Generated keys and certificates (GPG keys under keys/gpg/, TLS certs, SSL config).
# Ignore everything under keys/ except the placeholder so secrets never get committed.
keys/*
!keys/.gitkeep

# Generated/downloaded LDAP certificates (regenerated on each setup)
certs/ldap-local.crt
certs/ldaps_bundle.crt
certs/ldap-meta.crt
certs/ldap-meta.key
!certs/.gitkeep

# Generated SMTP certificates (regenerated by scripts/generate-smtp-certs.sh)
smtp4dev/certs/*
!smtp4dev/certs/.gitkeep

# Keep placeholder directories but not their contents
!config/db/.gitkeep
!config/php/.gitkeep
!config/ssl/.gitkeep
