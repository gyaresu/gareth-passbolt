{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks-local/safety-validator.sh\""
          },
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks-local/commit-filter.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks-local/shellcheck-hook.sh\""
          }
        ]
      }
    ]
  }
}
