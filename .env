# Passbolt Docker Testing Environment
# Prefix for container/volume names (e.g. dev_database_volume)
COMPOSE_PROJECT_NAME=dev

# Activate opt-in compose profiles by default. "memory" brings up qdrant
# and mcp-memory so Claude has persistent semantic memory on every `up`.
COMPOSE_PROFILES=memory

# Configuration options (uncomment to enable):
# ENABLE_RSYSLOG=true     # Enable rsyslog audit logging sidecar
# SKIP_KEYCLOAK=true      # Skip Keycloak SSO service
